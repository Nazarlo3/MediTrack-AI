GROQ_API_KEY=your_groq_api_key_here
AI_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=15

# Local synthetic demo only: AI_PROVIDER=fake, no real AI calls.
# FAKE_PROVIDER_ERROR=true demonstrates the controlled 503 response.
FAKE_PROVIDER_ERROR=false

# Optional Google collection. Keep real credentials in server secrets, never Git.
GOOGLE_SHEETS_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_HTTP_TRANSPORT=requests

# Optional durable queue: an absolute path on an existing PRIVATE PERSISTENT disk.
# Empty => confirmed synchronous Google writes; never an ephemeral RAM queue.
COLLECTION_OUTBOX_PATH=
